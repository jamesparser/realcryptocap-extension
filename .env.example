# Firebase web app config (Firebase console > Project settings > Your apps > SDK setup).
# These identify your project; they are not secrets, but keep your own copy out of git.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# App Check debug token (Firebase console > App Check > Apps > Manage debug tokens).
# A Chrome extension cannot load reCAPTCHA, so this build uses a debug token.
APPCHECK_DEBUG_TOKEN=
